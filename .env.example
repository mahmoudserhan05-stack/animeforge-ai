# ── Database ────────────────────────────────────────────────────────────────
# Default: local SQLite file, zero setup. For production, switch the
# provider in prisma/schema.prisma to "postgresql" and point this at your
# Postgres instance (e.g. Supabase, Neon, Railway, RDS).
DATABASE_URL="file:./dev.db"

# ── Auth (NextAuth.js) ──────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ── AI Providers ────────────────────────────────────────────────────────────
# Leave ALL of these empty to run entirely in Demo/Mock mode — every step of
# the wizard (script, scenes, images, voice, video) will work instantly with
# generated placeholder content. No credit card, no external calls.
#
# Fill any of these in and the matching provider is used automatically —
# see src/lib/ai/index.ts. Nothing in this file is ever read by the browser;
# all AI calls happen server-side (API routes / server actions only).

# Powers generateScript() and generateScenePrompts() (e.g. an OpenAI-compatible
# chat/completions API).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Powers generateImage() (e.g. an image-generation API).
IMAGE_API_KEY=
IMAGE_API_BASE_URL=

# Powers generateVoice() (e.g. a text-to-speech API).
VOICE_API_KEY=
VOICE_API_BASE_URL=

# Powers generateVideo() (e.g. a video-assembly/rendering API).
VIDEO_API_KEY=
VIDEO_API_BASE_URL=

# ── Credits ─────────────────────────────────────────────────────────────────
# Credits a brand-new account starts with.
SIGNUP_BONUS_CREDITS=100

# ── Payments (not wired up yet — structure is ready for it) ────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
